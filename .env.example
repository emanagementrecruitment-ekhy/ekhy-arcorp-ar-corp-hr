DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"

# --- Optional: real OTP delivery -------------------------------------------
# None of these are required. Set only the one(s) you have credentials for;
# the matching channel switches from console/dev-code fallback to real
# delivery automatically. Email logins use the Brevo API if BREVO_API_KEY is set, else SMTP; phone logins prefer
# WhatsApp (FONNTE_TOKEN) over SMS (TWILIO_*) when both are set. See
# src/lib/otp-providers.ts.

# Email OTP via Brevo HTTP API (preferred when set; falls back to SMTP below if it fails).
# Use an API key (starts with xkeysib-), not an SMTP key. SMTP_FROM must be a verified Brevo sender.
# Brevo blocks calls from unauthorized IPs by default: on hosts without a fixed IP (e.g. Railway),
# turn that off for API keys under Brevo > Security > Authorized IPs.
BREVO_API_KEY=""

# Email OTP via SMTP (any provider: Gmail app password, SendGrid, Mailgun, ...)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# WhatsApp OTP via Fonnte (https://fonnte.com) — sign up, connect a WhatsApp
# device/number in their dashboard, and copy the device token here.
FONNTE_TOKEN=""

# SMS OTP via Twilio (https://console.twilio.com) — used only if FONNTE_TOKEN is unset
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Push notification (kalender pengingat, lihat /admin/kalender) ---------
# Kunci VAPID untuk Web Push — generate sekali dengan:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY harus SAMA PERSIS dengan NEXT_PUBLIC_VAPID_PUBLIC_KEY
# (yang satu dipakai server untuk mengirim, yang satu dipakai browser untuk
# mendaftar langganan push).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@arcorp.id"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Optional: white-label licensing (see /lib/license.ts) ------------------
# Leave both unset for the vendor's own reference instance / local dev — no
# activation code is required to generate Owner. Set BOTH when deploying a
# cloned instance for a client: the AR License Console dashboard gives you
# the CLIENT_ID + one-time activation code when you register that client.
LICENSE_SERVER_URL=""
CLIENT_ID=""

# Asisten AI "Ara" (chat karyawan). Tanpa kunci ini Ara tetap jalan berbasis aturan
# (absen, VCR, Slip Pay, kasbon, pinalty) — kunci hanya menambah kemampuan menjawab
# pertanyaan bebas lewat Claude. Pertanyaan yang dikirim ke Claude dicatat di Riwayat Aktivitas.
ANTHROPIC_API_KEY=""
# Opsional: ID workspace Anthropic (wrkspc_...). Isi hanya bila kunci tidak terikat ke satu workspace
# dan Anthropic menolak dengan "API key is not scoped to a workspace" (HTTP 400).
ANTHROPIC_WORKSPACE_ID=""
# Opsional: model yang dipakai (default claude-opus-5-5). Contoh yang lebih hemat: claude-haiku-5-5
ASSISTANT_AI_MODEL=""
# Batas harian pertanyaan bebas ke Claude (pertanyaan umum yang dijawab aturan tidak dihitung).
# Total seluruh aplikasi per hari (default 300; 0 = matikan Claude) dan per orang per hari (default 20; kantor mendapat 3x lipat).
ASSISTANT_AI_DAILY_LIMIT=""
ASSISTANT_AI_PER_USER_LIMIT=""
# Opsional: pakai gateway AI pusat (Cloudflare Workers AI) untuk pertanyaan bebas KARYAWAN, sebagai ganti Claude.
# Kosong = perilaku lama. Isi AI_PROVIDER="gateway" + URL (wajib https) + token klien ini (rahasia, hanya di server).
# Nama dan kode karyawan tidak dikirim ke gateway. Mode kantor (admin) tidak ikut berubah.
AI_PROVIDER=""
AI_GATEWAY_URL=""
AI_GATEWAY_TOKEN=""
