DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"

# --- Optional: real OTP delivery -------------------------------------------
# Neither is required. Set only the one(s) you have credentials for; the
# matching channel (email vs. phone) switches from console/dev-code fallback
# to real delivery automatically. See src/lib/otp-providers.ts.

# Email OTP via SMTP (any provider: Gmail app password, SendGrid, Mailgun, ...)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS OTP via Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
