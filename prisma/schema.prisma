// AR Corp HR — commission/voucher-based payroll, GPS attendance, kasbon workflow.
// See /project/AR Corp HR.dc.html (design prototype) and /chats/chat1.md (design intent) at repo root.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support, so enum-like fields are plain String
// columns whose valid values are enforced in application code — see src/lib/constants.ts:
//   AccessRole:      KARYAWAN | OWNER | CONSULTANT | ADMIN_PUSAT
//   EmployeeLevel:   SILVER | PLATINUM
//   VoucherStatus:   MENUNGGU_VALIDASI | TERVALIDASI | DICAIRKAN
//   KasbonStatus:    MENUNGGU_OWNER | DISETUJUI | DITOLAK

model Employee {
  id          String       @id @default(cuid())
  code        String       @unique // e.g. AR-01
  name        String
  email       String       @unique
  phone       String       @unique
  level       String?      // Pendapatan/VCR preset — only set when role == "Tera" (see VCR_ROLE/usesVcr() in src/lib/constants.ts)
  customRate  Int?         // per-voucher rate when level == "MANUAL" (a preset doesn't fit); ignored otherwise
  salary      Int?         // fixed monthly Gaji nominal — only set when role != "Tera"; that group never uses VCR
  ageYears    Int?         // physical stats shown for talent listing — only meaningful when role == "Tera"
  weightKg    Int?
  heightCm    Int?
  role        String       // display role, e.g. "Konsultan Lapangan", "Supervisor Lapangan", "Owner AR Corp"
  accessRole  String       @default("KARYAWAN")
  homeLat     Float
  homeLng     Float
  homePlace   String
  channelLink String?      // manual free-text channel/link (e.g. WA/booking link), independent of Peran/supervisor
  supervisorId String?
  supervisor  Employee?    @relation("Supervision", fields: [supervisorId], references: [id])
  supervisorNote String?   // manual free-text note when the actual supervisor isn't a registered Kepala Mess account
  reports     Employee[]   @relation("Supervision")
  createdAt   DateTime     @default(now())

  otpCodes     OtpCode[]
  loginEvents  LoginEvent[]
  vouchers     Voucher[]
  kasbonRequests Kasbon[]     @relation("KasbonRequester")
  kasbonDecisions Kasbon[]    @relation("KasbonDecider")
  chatsAsEmployee ChatMessage[] @relation("ChatEmployee")
  chatsSent    ChatMessage[] @relation("ChatSender")
  payslipItems PayslipItem[]
  attendancePenaltyChecks AttendancePenaltyCheck[]
  savingEntries SavingEntry[]
}

model OtpCode {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([employeeId, createdAt])
}

model LoginEvent {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  distanceKm  Float
  inRadius    Boolean
  place       String?
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
}

model Voucher {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category   String        // SILVER = 150.000, PLATINUM (Jasmine) = 400.000
  amount     Int
  client     String
  status     String        @default("MENUNGGU_VALIDASI")
  occurredAt DateTime
  createdAt  DateTime      @default(now())

  @@index([employeeId, occurredAt])
}

model Kasbon {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation("KasbonRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  status      String       @default("MENUNGGU_OWNER")
  decidedById String?
  decidedBy   Employee?    @relation("KasbonDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime     @default(now())

  @@index([employeeId, createdAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  employeeId     String   // the field employee this thread belongs to
  employee       Employee @relation("ChatEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  senderId       String?  // null when sent by the fixed "supervisor" seed persona with no login of their own
  sender         Employee? @relation("ChatSender", fields: [senderId], references: [id])
  fromSupervisor Boolean
  text           String
  createdAt      DateTime @default(now())

  @@index([employeeId, createdAt])
}

// A manual line item on an employee's monthly Slip Pay (Rincian Totalan) —
// things the app has no other record of: admin/mess fees, penalties, item
// purchases, doctor top-ups, corrections, etc. "TOTAL VCR" and "KASBON" rows
// are NOT stored here; the payslip API computes those live from Voucher/
// Kasbon so they can never drift from the real numbers. debit/credit are
// mutually exclusive per row in practice (UI enforces it) — the running
// balance is previous + debit - credit, in (date, createdAt) order.
model PayslipItem {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String    // "YYYY-MM"
  date        DateTime?
  description String
  category    String?   // one of PAYSLIP_COST_CATEGORIES / ATTENDANCE_PENALTY_CATEGORY, or null for free-text rows
  qty         String?   // free text, e.g. "1 Pcs" — display only
  debit       Int       @default(0)
  credit      Int       @default(0)
  note        String?
  createdAt   DateTime  @default(now())

  @@index([employeeId, month])
}

// Marks that the automatic Pinalty Absensi check has already run for an
// employee+month, independent of whether the PayslipItem it created (if
// any) still exists — without this, deleting that row would just make it
// reappear the next time an admin opens the same month, defeating "Owner
// can edit or delete it".
model AttendancePenaltyCheck {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String   // "YYYY-MM"
  createdAt  DateTime @default(now())

  @@unique([employeeId, month])
}

// Tabungan (savings) log — a running per-employee history shown alongside
// the Slip Pay ledger but deliberately NOT one of its debit/credit rows: it's
// the employee/Tera's own money, not a company deduction, so it never
// changes the payslip total.
model SavingEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

// In-app notifications, broadcast to a role rather than a specific person —
// whoever currently holds recipientRole (OWNER / ADMIN_PUSAT / SUPERVISOR)
// sees it. Kept deliberately simple: read state is per-notification, not
// per-recipient, since ADMIN_PUSAT/SUPERVISOR are single-holder roles in
// practice (see the Jabatan Kantor appointment flow) and OWNER/CONSULTANT
// share visibility anyway.
model Notification {
  id            String    @id @default(cuid())
  recipientRole String
  text          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientRole, createdAt])
}

// Single-row app-wide config (always id "singleton" — see src/lib/settings.ts).
// themeColor/themeFont drive the dashboard's switchable palette/font (see
// THEME_COLORS/THEME_FONTS in src/lib/constants.ts). logoDataUrl holds an
// uploaded logo as a data: URL (small enough to store inline — see the
// size cap in /api/admin/settings/logo); null means "use the default AR
// Corp mark". logoUpdatedAt/logoUpdatedById back the 30-day
// re-upload lock. demoCleanupAt marks that the one-time production demo
// purge (prisma/cleanup-demo-employees.ts) has already run, so it never
// fires again and silently wipe real employees added after that first run.
model AppSetting {
  id              String    @id
  themeColor      String    @default("classic")
  themeFont       String    @default("classic")
  logoDataUrl     String?
  logoUpdatedAt   DateTime?
  logoUpdatedById String?
  demoCleanupAt   DateTime?
  updatedAt       DateTime  @updatedAt
}
