// AR Corp HR — commission/voucher-based payroll, GPS attendance, kasbon workflow.
// See /project/AR Corp HR.dc.html (design prototype) and /chats/chat1.md (design intent) at repo root.

generator client {
  provider      = "prisma-client-js"
  // "native" keeps Railway's Linux build working exactly as before;
  // "windows" additionally bundles the Windows query engine so the desktop
  // app (see desktop/) can ship a working Prisma Client on office PCs.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support, so enum-like fields are plain String
// columns whose valid values are enforced in application code — see src/lib/constants.ts:
//   AccessRole:      KARYAWAN | OWNER | CONSULTANT | ADMIN_PUSAT
//   EmployeeLevel:   SILVER | PLATINUM
//   VoucherStatus:   MENUNGGU_VALIDASI | TERVALIDASI | DICAIRKAN
//   KasbonStatus:    MENUNGGU_OWNER | DISETUJUI | DITOLAK

model Employee {
  id          String       @id @default(cuid())
  code        String       @unique // e.g. AR-01
  name        String
  email       String       @unique
  phone       String       @unique
  level       String?      // Pendapatan/VCR preset — only set when role == "Tera" (see VCR_ROLE/usesVcr() in src/lib/constants.ts)
  customRate  Int?         // per-voucher rate when level == "MANUAL" (a preset doesn't fit); ignored otherwise
  salary      Int?         // fixed monthly Gaji nominal — only set when role != "Tera"; that group never uses VCR
  ageYears    Int?         // physical stats shown for talent listing — only meaningful when role == "Tera"
  weightKg    Int?
  heightCm    Int?
  role        String       // display role, e.g. "Konsultan Lapangan", "Supervisor Lapangan", "Owner AR Corp"
  accessRole  String       @default("KARYAWAN")
  status      String       @default("AKTIF") // "AKTIF" | "RESIGN" (see EMPLOYEE_STATUSES in src/lib/constants.ts) — a resigned employee can no longer log in (see findEmployeeForPortal) and drops out of the active Data Karyawan/Data Tera list, but their history (voucher/absensi/slip pay) stays intact for reports, unlike a hard delete
  homeLat     Float
  homeLng     Float
  homePlace   String
  channelLink String?      // manual free-text channel/link (e.g. WA/booking link), independent of Peran/supervisor
  supervisorId String?
  supervisor  Employee?    @relation("Supervision", fields: [supervisorId], references: [id])
  supervisorNote String?   // manual free-text note when the actual supervisor isn't a registered Kepala Mess account
  reports     Employee[]   @relation("Supervision")
  createdAt   DateTime     @default(now())
  photoDataUrl   String?   // self-service profile photo, replacing the initials-monogram avatar when set
  photoUpdatedAt DateTime? // 30-day lock (see isLogoLocked/logoUnlockDate in src/lib/settings.ts) — Owner/Consultant can clear it early via the admin photo route

  otpCodes     OtpCode[]
  loginEvents  LoginEvent[]
  attendances  Attendance[]
  vouchers     Voucher[]
  kasbonRequests Kasbon[]     @relation("KasbonRequester")
  kasbonDecisions Kasbon[]    @relation("KasbonDecider")
  chatsAsEmployee ChatMessage[] @relation("ChatEmployee")
  chatsSent    ChatMessage[] @relation("ChatSender")
  payslipItems PayslipItem[]
  attendancePenaltyChecks AttendancePenaltyCheck[]
  savingEntries SavingEntry[]
  recurringCosts RecurringCost[]
  reminderRecipients ReminderRecipient[]
  pushSubscriptions  PushSubscription[]
  resignPayslips     ResignPayslip[]
}

model OtpCode {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([employeeId, createdAt])
}

model LoginEvent {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  distanceKm  Float
  inRadius    Boolean
  place       String?
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
}

// One row = one calendar day an employee/Tera marked themselves present, via
// the self check-in box on their own home screen (one tap per day, today
// only — no backdating). This is the source of truth for "Hari Hadir" and
// the automatic Pinalty Absensi (see src/lib/attendance.ts) — it replaced
// the GPS LoginEvent count for that purpose; LoginEvent itself keeps running
// unchanged for the location-radius check at login.
model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dateKey    String   // "YYYY-MM-DD"
  month      String   // "YYYY-MM" — denormalized for fast per-month grouping
  createdAt  DateTime @default(now())

  @@unique([employeeId, dateKey])
  @@index([employeeId, month])
  @@index([month])
}

model Voucher {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category   String        // SILVER = 150.000, PLATINUM (Jasmine) = 400.000
  amount     Int
  client     String
  status     String        @default("MENUNGGU_VALIDASI")
  occurredAt DateTime
  createdAt  DateTime      @default(now())

  @@index([employeeId, occurredAt])
}

model Kasbon {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation("KasbonRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  status      String       @default("MENUNGGU_OWNER")
  decidedById String?
  decidedBy   Employee?    @relation("KasbonDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime     @default(now())

  @@index([employeeId, createdAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  employeeId     String   // the field employee this thread belongs to
  employee       Employee @relation("ChatEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  senderId       String?  // null when sent by the fixed "supervisor" seed persona with no login of their own
  sender         Employee? @relation("ChatSender", fields: [senderId], references: [id])
  fromSupervisor Boolean
  text           String
  createdAt      DateTime @default(now())

  @@index([employeeId, createdAt])
}

// A manual line item on an employee's monthly Slip Pay (Rincian Totalan) —
// things the app has no other record of: admin/mess fees, penalties, item
// purchases, doctor top-ups, corrections, etc. "TOTAL VCR" and "KASBON" rows
// are NOT stored here; the payslip API computes those live from Voucher/
// Kasbon so they can never drift from the real numbers. debit/credit are
// mutually exclusive per row in practice (UI enforces it) — the running
// balance is previous + debit - credit, in (date, createdAt) order.
model PayslipItem {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String    // "YYYY-MM"
  date        DateTime?
  description String
  category    String?   // one of PAYSLIP_COST_CATEGORIES / ATTENDANCE_PENALTY_CATEGORY, or null for free-text rows
  qty         String?   // free text, e.g. "1 Pcs" — display only
  debit       Int       @default(0)
  credit      Int       @default(0)
  note        String?
  createdAt   DateTime  @default(now())

  // Set only on a row auto-generated by ensureRecurringCosts() — links it
  // back to the RecurringCost template that produced it, so that function
  // never generates a second row for the same template+month. onDelete
  // SetNull: removing the template must not erase months it already billed.
  recurringCostId String?
  recurringCost   RecurringCost? @relation(fields: [recurringCostId], references: [id], onDelete: SetNull)

  @@index([employeeId, month])
}

// A recurring Slip Pay deduction/cost for one Tera — created once (Admin
// picks a PAYSLIP_COST_CATEGORIES category + nominal), then
// ensureRecurringCosts() auto-generates the matching PayslipItem every
// month from startMonth onward until Owner/Admin edits the nominal or
// deletes the rule entirely. Deleting only stops future months — it never
// touches PayslipItem rows already generated for past months.
model RecurringCost {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category   String        // one of PAYSLIP_COST_CATEGORIES
  amount     Int
  note       String?
  startMonth String        // "YYYY-MM" — first month this is billed from
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  items      PayslipItem[]

  @@index([employeeId])
}

// Marks that the automatic Pinalty Absensi check has already run for an
// employee+month, independent of whether the PayslipItem it created (if
// any) still exists — without this, deleting that row would just make it
// reappear the next time an admin opens the same month, defeating "Owner
// can edit or delete it".
model AttendancePenaltyCheck {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String   // "YYYY-MM"
  createdAt  DateTime @default(now())

  @@unique([employeeId, month])
}

// Tabungan (savings) log — a running per-employee history shown alongside
// the Slip Pay ledger but deliberately NOT one of its debit/credit rows: it's
// the employee/Tera's own money, not a company deduction, so it never
// changes the payslip total.
model SavingEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

// In-app notifications, broadcast to a role rather than a specific person —
// whoever currently holds recipientRole (OWNER / ADMIN_PUSAT / SUPERVISOR)
// sees it. Kept deliberately simple: read state is per-notification, not
// per-recipient, since ADMIN_PUSAT/SUPERVISOR are single-holder roles in
// practice (see the Jabatan Kantor appointment flow) and OWNER/CONSULTANT
// share visibility anyway.
model Notification {
  id            String    @id @default(cuid())
  recipientRole String
  text          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientRole, createdAt])
}

// Kalender pengingat (Admin/Owner) — satu Reminder dikirim ke satu atau lebih
// karyawan/Tera lewat push notification. Daftar penerima dibekukan saat dibuat
// (lihat ReminderRecipient) — memilih "Semua" hanya menyalin roster saat itu,
// bukan langganan dinamis, supaya riwayat tetap akurat walau roster berubah.
model Reminder {
  id            String    @id @default(cuid())
  title         String
  message       String
  scheduledAt   DateTime
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  sentAt        DateTime? // diisi scheduler (lihat src/instrumentation.ts) setelah push dikirim
  recipients    ReminderRecipient[]

  @@index([scheduledAt, sentAt])
}

model ReminderRecipient {
  id          String    @id @default(cuid())
  reminderId  String
  reminder    Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deliveredAt DateTime?

  @@unique([reminderId, employeeId])
  @@index([employeeId])
}

// Web Push subscription per perangkat karyawan (satu karyawan bisa login di
// beberapa HP/browser sekaligus, masing-masing punya endpoint sendiri).
model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

// Single-row app-wide config (always id "singleton" — see src/lib/settings.ts).
// themeColor/themeFont drive the dashboard's switchable palette/font (see
// THEME_COLORS/THEME_FONTS in src/lib/constants.ts). logoDataUrl holds an
// uploaded logo as a data: URL (small enough to store inline — see the
// size cap in /api/admin/settings/logo); null means "use the default AR
// Corp mark". logoUpdatedAt/logoUpdatedById back the 30-day
// re-upload lock. demoCleanupAt marks that the one-time production demo
// purge (prisma/cleanup-demo-employees.ts) has already run, so it never
// fires again and silently wipe real employees added after that first run.
model AppSetting {
  id              String    @id
  themeColor      String    @default("classic")
  themeFont       String    @default("classic")
  lightMode       String    @default("auto") // "auto" | "light" | "dark" — see LIGHT_MODES in src/lib/constants.ts
  logoDataUrl     String?
  logoUpdatedAt   DateTime?
  logoUpdatedById String?
  demoCleanupAt   DateTime?

  // Owner identity provisioning (see /dev/nav-layout and
  // src/app/api/admin/owner-identity) — separate from the main brand
  // logoDataUrl above so changing it never touches the app-wide logo used
  // on the login screen, sidebar, and Slip Pay. ownerGeneratedAt null means
  // no Owner has been "patenkan" (generated/sealed) yet — Name/Email/HP
  // live on the Employee row with the reserved code HQ-OWNER, not here.
  // ownerWelcomeSeenAt null means the one-time welcome screen still owes a
  // showing to whoever next logs in as Owner; it's cleared back to null
  // every time Consultant regenerates the Owner so the new person sees it
  // again.
  ownerGeneratedAt   DateTime?
  ownerWelcomeSeenAt DateTime?
  ownerLogoDataUrl   String?

  // Package tier cache for white-label deployments (see src/lib/license.ts)
  // — mirrors the vendor's License Server employeeLimit for this CLIENT_ID
  // so "Tambah Karyawan" can enforce it without a network round-trip on
  // every add. Refreshed on every reportCheckin(). null means unlimited OR
  // licensing not configured for this deployment — either way, no cap.
  employeeLimit Int?

  updatedAt DateTime @updatedAt
}

// A frozen Slip Pay snapshot for the calendar month an employee/Tera was
// marked RESIGN in (see PATCH /api/admin/employees/[id]/status) — captured
// as an actual PDF at that moment rather than left to buildPayslip()'s live
// computation, since Voucher/Kasbon/PayslipItem data a resigned employee
// leaves behind can still be edited or cleaned up later and the last slip
// they were owed must not silently change or disappear with it. Deliberately
// gated tighter than every other payslip route (OWNER/CONSULTANT only, not
// ADMIN_PUSAT) — see src/app/api/admin/resign-payslip/*.
model ResignPayslip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String   // "YYYY-MM" — the month captured, normally the one Resign was clicked in
  filename   String
  pdfData    Bytes
  createdAt  DateTime @default(now())

  @@unique([employeeId, month])
  @@index([employeeId])
}
